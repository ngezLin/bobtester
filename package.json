{
  "name": "bobtester-workspace",
  "private": true,
  "workspaces": [
    "framework",
    "client/gui/app",
    "client/gui/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "framework:build": "npm run build --workspace=bobtester",
    "gui:dev": "npm run dev --workspace=@bobtester/gui-app",
    "gui:server": "npm run dev --workspace=@bobtester/gui-server",
    "gui:build": "npm run build --workspace=@bobtester/gui-app",
    "gui:server:build": "npm run build --workspace=@bobtester/gui-server",
    "client:dev": "npm run dev --prefix client"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "pg": "^8.20.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
